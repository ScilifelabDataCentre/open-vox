# STT API configuration
# Full URL of the transcription endpoint, including the path (an
# OpenAI-compatible /v1/audio/transcriptions route). The domain here is only
# a placeholder.
STT_ENDPOINT=https://stt.example.com/v1/audio/transcriptions
STT_API_KEY=your-api-key-here
STT_MODEL=voxtral-small-24b

# Audio processing configuration
# Sample rate (Hz) the audio is converted to before upload. 16000 suits most
# speech recognition models. It also sets which MP3 bitrates are allowed.
AUDIO_SAMPLE_RATE=16000
# Number of audio channels before upload. 1 = mono, which is usual for
# speech recognition and halves the size compared with stereo.
AUDIO_CHANNELS=1
# MP3 constant bitrate for uploaded audio. Must be valid for the sample rate
# (at 16 kHz: 8–160 kbps in standard steps). Also used to plan chunk sizes.
# 16, 22.05 or 24 kHz: 8, 16, 24, 32, 40, 48, 56, 64, 80, 96, 112, 128, 144, 160 kbps
# 32, 44.1 or 48 kHz: 32, 40, 48, 56, 64, 80, 96, 112, 128, 160, 192, 224, 256, 320 kbps
AUDIO_BITRATE_KBPS=48

# Chunking limits for the target STT endpoint (per-target settings).
# The maximum file size is the primary limit: audio is split so each chunk is
# no bigger than this, with a safety margin (see CHUNK_SAFETY). The duration
# limit is a second, independent cap. An upload-time limit will be added later
# as another input to the same maximum-length calculation, without changing how
# splitting works.
CHUNK_MAX_SIZE_BYTES=26214400
CHUNK_MAX_DURATION_S=600
# Fraction of the size limit to plan chunks at (0 < value <= 1).
CHUNK_SAFETY=0.9
